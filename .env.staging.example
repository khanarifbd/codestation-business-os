COMPOSE_PROJECT_NAME=codestation-business-os

# Public staging URLs
NEXT_PUBLIC_API_URL=https://api-os.codestationai.com/api/v1
CORS_ORIGINS=https://os.codestationai.com
PUBLIC_APP_URL=https://os.codestationai.com

APP_NAME=CodeStation Business OS API
APP_VERSION=0.5.0

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Password-account email verification and recovery. Staging/production refuse
# password signup/recovery when SMTP delivery is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@codestationai.com
SMTP_FROM_NAME=CodeStation AI Business OS
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Google Identity Services. Use the same Web OAuth client ID on frontend and backend.
# Authorized JavaScript origins should include https://os.codestationai.com.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# Global platform super admin. deployment/deploy.sh bootstraps these when absent.
SUPER_ADMIN_EMAIL=admin@codestationai.com
SUPER_ADMIN_PASSWORD=replace_with_a_long_random_super_admin_password
SUPER_ADMIN_NAME=CodeStation AI Super Admin

# PostgreSQL
POSTGRES_USER=business_os
POSTGRES_DB=codestation_business_os
POSTGRES_PASSWORD=replace_with_a_long_random_password

# PostgreSQL application pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# Private company document uploads. Docker persists this path in a named volume.
LOCAL_STORAGE_PATH=/data/uploads
MAX_DOCUMENT_UPLOAD_MB=20

# Credentials Vault encryption. deploy.sh generates a secure value when the
# placeholder/missing value is detected.
PROJECT_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_project_credential_key

# Encrypted disaster-recovery backups. deploy.sh generates BACKUP_ENCRYPTION_KEY
# when missing/placeholder and creates a pre-migration backup on every deploy.
# Keep a copy of this key outside the VPS (for example, a secure password manager).
BACKUP_ENCRYPTION_KEY=replace_with_a_long_random_backup_encryption_key
BACKUP_DIR=/var/backups/codestation-business-os
BACKUP_RETENTION_DAYS=14

# Optional off-server copy over rsync/SSH, for example:
# BACKUP_REMOTE_RSYNC_TARGET=backup-user@backup-host:/srv/backups/codestation-business-os
# Set required=true only after SSH/rsync has been configured and tested.
BACKUP_REMOTE_RSYNC_TARGET=
BACKUP_REMOTE_REQUIRED=false
