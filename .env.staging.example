COMPOSE_PROJECT_NAME=codestation-business-os

# Public staging URLs
NEXT_PUBLIC_API_URL=https://api-os.codestationai.com/api/v1
CORS_ORIGINS=https://os.codestationai.com

APP_NAME=CodeStation Business OS API
APP_VERSION=0.3.0

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Global platform super admin. deployment/deploy.sh bootstraps these when absent.
SUPER_ADMIN_EMAIL=admin@codestationai.com
SUPER_ADMIN_PASSWORD=replace_with_a_long_random_super_admin_password
SUPER_ADMIN_NAME=CodeStation AI Super Admin

# PostgreSQL
POSTGRES_USER=business_os
POSTGRES_DB=codestation_business_os
POSTGRES_PASSWORD=replace_with_a_long_random_password

# PostgreSQL application pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
